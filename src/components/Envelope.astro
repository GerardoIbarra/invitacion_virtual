---
import { event, formatLongDate } from '../data/event';
import { useTranslations, type Lang } from '../i18n/ui';
import Tiara from './Tiara.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<div id="envelope-overlay" class="envelope-overlay">
  <div class="envelope-stage">
    <header class="envelope-heading">
      <Tiara class="envelope-tiara" />
      <p class="env-to">{t('envelope.to')}</p>
      <p class="env-occasion">{t('envelope.title')}</p>
      <p class="env-date">{formatLongDate(event.startsAt, lang)}</p>
    </header>

    <div class="envelope" id="envelope-box">
      <!-- Interior: el forro lila que aparece al abrir la solapa. -->
      <div class="env-liner" aria-hidden="true"></div>

      <div class="env-card" aria-hidden="true">
        <Tiara class="env-card-tiara" />
        <p class="env-card-title">{t('envelope.cardTitle')}</p>
        <p class="env-card-name">{event.quinceName}</p>
      </div>

      <div class="env-front" aria-hidden="true">
        <p class="env-name">{event.quinceName}</p>
      </div>

      <div class="env-flap" aria-hidden="true"></div>

      <!-- Listón de satín que cruza el sobre, con un moño cuyo nudo es el sello. -->
      <div class="env-ribbon" aria-hidden="true"></div>
      <svg class="env-bow" viewBox="0 0 240 120" aria-hidden="true">
        <defs>
          <linearGradient id="bow-satin" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#C2A6DB" />
            <stop offset="0.45" stop-color="#8F6CB2" />
            <stop offset="1" stop-color="#5A3B7A" />
          </linearGradient>
          <linearGradient id="bow-fold" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#6B4890" />
            <stop offset="1" stop-color="#3F2459" />
          </linearGradient>
          <linearGradient id="bow-tail" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#7D5AA2" />
            <stop offset="0.5" stop-color="#A585C6" />
            <stop offset="1" stop-color="#5E3F7E" />
          </linearGradient>
        </defs>
        <g>
          <!-- Punta -->
          <path d="M112 58 L84 84 L94 82 L96 94 L124 62 Z" fill="url(#bow-tail)" />
          <!-- Lazo -->
          <path d="M116 50 C96 8 30 -2 22 30 C16 56 56 74 116 58 Z" fill="url(#bow-satin)" />
          <!-- Pliegue interior -->
          <path d="M116 52 C96 30 52 22 42 36 C56 44 92 50 116 58 Z" fill="url(#bow-fold)" opacity="0.85" />
          <!-- Brillo del satín -->
          <path d="M104 32 C88 12 48 6 32 24" fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="2" stroke-linecap="round" />
        </g>
        <g transform="translate(240 0) scale(-1 1)">
          <path d="M112 58 L84 84 L94 82 L96 94 L124 62 Z" fill="url(#bow-tail)" />
          <path d="M116 50 C96 8 30 -2 22 30 C16 56 56 74 116 58 Z" fill="url(#bow-satin)" />
          <path d="M116 52 C96 30 52 22 42 36 C56 44 92 50 116 58 Z" fill="url(#bow-fold)" opacity="0.85" />
          <path d="M104 32 C88 12 48 6 32 24" fill="none" stroke="#fff" stroke-opacity="0.35" stroke-width="2" stroke-linecap="round" />
        </g>
      </svg>

      <button type="button" class="wax-seal" id="wax-seal" aria-label={t('envelope.open')}>
        <span class="wax-seal-inner">XV</span>
      </button>
    </div>

    <p class="envelope-hint" aria-hidden="true">{t('envelope.hint')}</p>
  </div>
</div>
