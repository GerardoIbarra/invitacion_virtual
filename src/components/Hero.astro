---
import { Image } from 'astro:assets';
import { event, formatLongDate } from '../data/event';
import { useTranslations, type Lang } from '../i18n/ui';
import Tiara from './Tiara.astro';
import tiara from '../assets/tiara.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<header class="hero-section">
  <Tiara class="hero-tiara" />

  <p class="hero-pretitle">{t('hero.pretitle')}</p>

  <h1 class="hero-title">
    {t('hero.titleBefore') && <span class="hero-title-small">{t('hero.titleBefore')}</span>}
    <span class="hero-title-xv">{t('hero.titleXV')}</span>
    {t('hero.titleAfter') && <span class="hero-title-small">{t('hero.titleAfter')}</span>}
  </h1>

  <p class="hero-name">{event.quinceName}</p>
  <p class="hero-surname">{event.quinceSurname}</p>

  <figure class="arch-frame hero-photo">
    <Image
      src={tiara}
      alt={t('hero.photoAlt')}
      widths={[360, 720]}
      sizes="(max-width: 560px) 78vw, 400px"
      loading="eager"
      fetchpriority="high"
    />
  </figure>

  <p class="hero-date">{formatLongDate(event.startsAt, lang)}</p>

  <blockquote class="hero-quote">
    <p>{t('hero.quote')}</p>
  </blockquote>
</header>
