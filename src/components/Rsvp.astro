---
import { event, rsvpSmsUrl } from '../data/event';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const defaultUrl = rsvpSmsUrl(lang, 2);
---

<section class="section rsvp-section" id="rsvp" aria-labelledby="rsvp-title">
  <!-- Icono de calendario con corazón inspirado en el diseño solicitado -->
  <div class="rsvp-icon-wrap" aria-hidden="true">
    <svg class="rsvp-calendar-icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <!-- Arillos del calendario -->
      <path d="M20 7v7M32 7v7M44 7v7" />
      <!-- Silueta del calendario -->
      <rect x="11" y="14" width="42" height="43" rx="7" />
      <!-- Barra superior del mes -->
      <path d="M11 25h42" />
      <!-- Corazón en el centro -->
      <path class="rsvp-heart" d="M32 47.5 C32 47.5 22.5 41.5 22.5 35 C22.5 31.6 25.1 29 28.3 29 C30.2 29 31.5 30 32 31.1 C32.5 30 33.8 29 35.7 29 C38.9 29 41.5 31.6 41.5 35 C41.5 41.5 32 47.5 32 47.5 Z" />
    </svg>
  </div>

  <h2 class="rsvp-title" id="rsvp-title">{t('rsvp.title')}</h2>
  <p class="rsvp-eyebrow">{t('rsvp.eyebrow')}</p>

  <!-- Tarjeta interactiva para indicar cuántos van -->
  <div class="rsvp-card">
    <div class="rsvp-field">
      <span class="rsvp-field-label" id="rsvp-count-label">{t('rsvp.guestsLabel')}</span>
      <div class="rsvp-counter" role="group" aria-labelledby="rsvp-count-label">
        <button
          type="button"
          id="rsvp-minus"
          class="rsvp-counter-btn"
          aria-label={lang === 'es' ? 'Disminuir personas' : 'Decrease guests'}
        >
          −
        </button>
        <span id="rsvp-count" class="rsvp-counter-value" aria-live="polite">2</span>
        <button
          type="button"
          id="rsvp-plus"
          class="rsvp-counter-btn"
          aria-label={lang === 'es' ? 'Aumentar personas' : 'Increase guests'}
        >
          +
        </button>
      </div>
    </div>

    <!-- Botón que envía un mensaje de texto prellenado -->
    <a
      id="rsvp-submit-btn"
      href={defaultUrl}
      class="rsvp-btn"
      data-phone={event.rsvp.phone}
      data-quince={event.quinceName}
    >
      <span>{t('rsvp.button')}</span>
    </a>
  </div>

  <!-- Cierre emotivo -->
  <div class="rsvp-farewell">
    <p class="rsvp-hope">{t('rsvp.hope')}</p>
    <p class="rsvp-thanks">{t('rsvp.thanks')}</p>
  </div>
</section>

