---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---
<section class="section dress-section" aria-labelledby="dress-title">
  <h2 class="dress-script-title" id="dress-title">{t('dress.eyebrow')}</h2>
  <p class="dress-formal-title">{t('dress.title')}</p>

  <svg class="dress-ornament" viewBox="0 0 100 16" aria-hidden="true" fill="none" stroke="currentColor">
    <path d="M15 8 Q38 8 46 3 Q50 1 54 8 Q58 15 62 8 Q70 8 85 8" stroke-width="0.8" stroke-linecap="round"></path>
    <circle cx="50" cy="8" r="2" fill="currentColor"></circle>
    <circle cx="36" cy="8" r="1.3" fill="currentColor"></circle>
    <circle cx="64" cy="8" r="1.3" fill="currentColor"></circle>
  </svg>

  <p class="reserved-note" role="note">
    <span class="swatch-dot swatch-reserved" aria-hidden="true"></span>
    <span><strong>{t('dress.reservedTitle')}</strong> {t('dress.reservedText')}</span>
  </p>
</section>
