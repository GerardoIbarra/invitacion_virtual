---
import { event } from '../data/event';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---
<section class="section family-section" aria-label={t('family.label')}>
  <h2 class="section-eyebrow">{t('family.parents')}</h2>
  <p class="family-names">{event.parents}</p>

  <h2 class="section-eyebrow">{t('family.godparents')}</h2>
  <p class="family-names">{event.godparents}</p>
</section>
