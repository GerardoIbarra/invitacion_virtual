---
import { event, formatShortDate } from '../data/event';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<!-- Tarjeta de respuesta aparte, como en un juego de invitación impreso. -->
<section class="reply-card" id="rsvp-anchor" aria-labelledby="rsvp-title">
  <p class="reply-mark">R.S.V.P.</p>
  <h2 class="section-title" id="rsvp-title">{t('rsvp.title')}</h2>
  <p class="section-lede">{t('rsvp.eyebrow')(formatShortDate(event.rsvpDeadline, lang))}</p>

  <form id="rsvp-form" class="reply-form" novalidate>
    <fieldset class="choice-group">
      <legend class="visually-hidden">{t('rsvp.attendance')}</legend>
      <label class="choice">
        <input type="radio" name="attendance" value="si" checked>
        <span>{t('rsvp.yes')}</span>
      </label>
      <label class="choice">
        <input type="radio" name="attendance" value="no">
        <span>{t('rsvp.no')}</span>
      </label>
    </fieldset>

    <div class="field">
      <label for="guest-name">{t('rsvp.name')}</label>
      <input type="text" id="guest-name" name="guest_name" autocomplete="name"
        placeholder={t('rsvp.namePlaceholder')} required aria-describedby="guest-name-error">
      <p class="field-error" id="guest-name-error" hidden>{t('rsvp.nameError')}</p>
    </div>

    <div class="field" id="passes-group">
      <label for="guest-passes">{t('rsvp.guests')}</label>
      <div class="stepper">
        <button type="button" class="stepper-btn" id="step-minus" aria-label={t('rsvp.less')}>−</button>
        <input type="number" id="guest-passes" name="guest_passes" value="2" min="1" max="10" inputmode="numeric">
        <button type="button" class="stepper-btn" id="step-plus" aria-label={t('rsvp.more')}>+</button>
      </div>
    </div>

    <div class="field">
      <label for="guest-message">
        {t('rsvp.message')(event.quinceName)} <span class="optional">{t('rsvp.optional')}</span>
      </label>
      <textarea id="guest-message" name="guest_message" rows="2" placeholder={t('rsvp.messagePlaceholder')}></textarea>
    </div>

    <button type="submit" class="btn">{t('rsvp.submit')}</button>
  </form>
</section>
