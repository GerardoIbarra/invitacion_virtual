---
import { event, formatTicketDate } from '../data/event';
import { useTranslations, type Lang } from '../i18n/ui';
import Tiara from './Tiara.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="section pass-section" aria-labelledby="vip-title">
  <p class="section-eyebrow">{t('pass.eyebrow')}</p>
  <h2 class="section-title" id="vip-title">{t('pass.title')}</h2>

  <div class="ticket" id="vip-ticket">
    <p class="ticket-brand"><Tiara class="ticket-tiara" /> {t('pass.brand')}</p>
    <p class="ticket-guest" id="ticket-guest-name">{t('pass.for')(t('pass.defaultGuest'))}</p>
    <p class="ticket-meta">
      {t('pass.passes')} <span id="ticket-passes-count">2 {t('rsvp.people')}</span>
    </p>
    <p class="ticket-date">{formatTicketDate(event.startsAt, lang)}</p>
  </div>
</section>
